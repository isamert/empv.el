;;; empv-test.el --- Tests for empv -*- lexical-binding: t; -*-

(require 'ert)
(require 'empv)

(ert-deftest empv-start-starts-ivjs-before-mpv ()
  (let ((empv-invidious-instance 'ivjs)
        (calls nil))
    (cl-letf (((symbol-function 'empv--running?) (lambda () nil))
              ((symbol-function 'empv--ensure-ivjs-started)
               (lambda () (push 'ivjs calls)))
              ((symbol-function 'empv--make-process)
               (lambda (&rest _) (push 'mpv calls)))
              ((symbol-function 'empv--make-network-process) #'ignore)
              ((symbol-function 'empv-observe) #'ignore)
              ((symbol-function 'run-hooks) #'ignore))
      (empv-start)
      (should (equal (nreverse calls) '(ivjs mpv))))))

(ert-deftest empv-ensure-ivjs-started-does-not-wait-synchronously ()
  (let ((empv-invidious-instance 'ivjs)
        (empv--ivjs-process nil)
        (process 'fake-process)
        (properties (make-hash-table))
        (timer-callback nil)
        (retrieve-callback nil)
        (sync-request-called nil)
        (ready-callbacks nil))
    (cl-letf (((symbol-function 'executable-find) (lambda (_) "deno"))
              ((symbol-function 'make-process) (lambda (&rest _) process))
              ((symbol-function 'process-live-p) (lambda (p) (eq p process)))
              ((symbol-function 'process-put)
               (lambda (p key value)
                 (should (eq p process))
                 (puthash key value properties)))
              ((symbol-function 'process-get)
               (lambda (p key)
                 (should (eq p process))
                 (gethash key properties)))
              ((symbol-function 'run-at-time)
               (lambda (_delay _repeat function &rest args)
                 (setq timer-callback (lambda () (apply function args)))))
              ((symbol-function 'url-retrieve)
               (lambda (_url callback &rest _)
                 (setq retrieve-callback callback)))
              ((symbol-function 'empv--request-raw-sync)
               (lambda (&rest _)
                 (setq sync-request-called t)
                 (error "Synchronous request must not be used"))))
      (empv--ensure-ivjs-started
       (lambda () (push 'ready ready-callbacks)))
      (should (not sync-request-called))
      (should (functionp timer-callback))
      (should-not ready-callbacks)
      (funcall timer-callback)
      (should (functionp retrieve-callback))
      (with-temp-buffer
        (insert "HTTP/1.1 200 OK\r\n\r\npong")
        (funcall retrieve-callback nil process))
      (should (equal ready-callbacks '(ready)))
      (should (gethash :ready properties)))))
